#include <iostream>
using namespace std;

int main()
{
    int arr[10][10], rows, cols, i, j;

    cout << "Enter number of rows: ";
    cin >> rows;

    cout << "Enter number of columns: ";
    cin >> cols;

    cout << "Enter array elements: ";
    for(i = 0; i < rows; i++)
    {
        for(j = 0; j < cols; j++)
        {
            cin >> arr[i][j];
        }
    }

    cout << "2D Array is:" << endl;

    for(i = 0; i < rows; i++)
    {
        for(j = 0; j < cols; j++)
        {
            cout << arr[i][j] << " ";
        }
        cout << endl;
    }

    return 0;
}