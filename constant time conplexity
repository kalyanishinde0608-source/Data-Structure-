#include <iostream>
using namespace std;

int main()
{
    int arr[5] = {10, 20, 30, 40, 50};

    cout << "Array elements are: ";
    for(int i = 0; i < 5; i++)
    {
        cout << arr[i] << " ";
    }

    cout << endl;

    // Constant time operation
    cout << "Element at index 2: " << arr[2];

    return 0;
}