#include <iostream>
using namespace std;

int st[100];
int top = -1;
int n;

int main()
{
    int value;

    cout << "Enter size of stack: ";
    cin >> n;

    if(top == n - 1)
    {
        cout << "Stack Overflow";
    }
    else
    {
        cout << "Enter element to push: ";
        cin >> value;

        top++;
        st[top] = value;

        cout << "Element pushed successfully";
    }

    return 0;
}